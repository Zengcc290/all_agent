# ============================================================
#  知识图谱入库系统 - 环境变量模板
#  复制为 .env 后按实际情况填写：  copy .example.env .env
# ============================================================

# ---------- 1. LLM（OpenAI 兼容 /chat/completions，流式输出）----------
# 模型名称（例：Qwen/Qwen2.5-7B-Instruct、deepseek-ai/DeepSeek-V3）
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# API 密钥
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 请求地址（base_url，代码会自动拼接 /chat/completions）
LLM_BASE_URL=https://api.siliconflow.cn/v1
# 采样温度
LLM_TEMPERATURE=0.1
# 是否流式输出（true / false）
LLM_STREAM=true
# 单次请求超时（秒）
LLM_TIMEOUT=120
# 最大生成 token
LLM_MAX_TOKENS=2048

# ---------- 2. Embedding 模型（硅基流动 /v1/embeddings 标准格式）----------
# 请求地址（base_url，代码会自动拼接 /embeddings）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 模型名称（例：BAAI/bge-m3、BAAI/bge-large-zh-v1.5）
EMBEDDING_MODEL=BAAI/bge-m3
# API 密钥
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 向量维度（必须与所选模型一致：bge-m3=1024，bge-large-zh=1024，bge-small-zh=512）
EMBEDDING_DIM=1024
# 单次批量编码条数
EMBEDDING_BATCH_SIZE=32
# 请求超时（秒）
EMBEDDING_TIMEOUT=60

# ---------- 3. Qdrant 向量数据库（本地）----------
# 默认连「本地真实 qdrant 服务」：由 启动所有服务.bat 在 127.0.0.1:6333 拉起
# Windows 原生版下载：github.com/qdrant/qdrant/releases 里的 qdrant-x86_64-pc-windows-msvc.zip
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# 是否走 grpc（false = REST，更省事）
QDRANT_PREFER_GRPC=false
# 集合名称
QDRANT_COLLECTION=kg_chunks
# 若本地未开启鉴权则留空
QDRANT_API_KEY=
# 距离度量：cosine / dot / euclid
QDRANT_DISTANCE=cosine
# 是否在启动时自动创建集合
QDRANT_AUTO_CREATE=true
# 嵌入式本地模式：填一个目录（如 ./data/qdrant）就改用 qdrant 引擎的本地嵌入式存储，
# 不需要单独启动 qdrant 服务；否则连接上面的 QDRANT_HOST:QDRANT_PORT。
# （嵌入式模式同一时刻只允许一个进程打开同一个目录，多进程并发入库时请用上面的服务模式）
QDRANT_LOCAL_PATH=

# ---------- 4. Neo4j 图数据库（本地回环）----------
# 访问链接：bolt://<host>:<port>
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123456
NEO4J_DATABASE=neo4j
# 连接超时（秒）
NEO4J_TIMEOUT=30

# ---------- 5. SQLite（原始文档 / 入库状态 / chunk）----------
SQLITE_PATH=./data/kg.db

# ---------- 6. 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
# 允许跨域的前端地址，多个用逗号分隔，* 表示全部
CORS_ORIGINS=*
# 工具单次并行上限
TOOL_MAX_CONCURRENCY=8
