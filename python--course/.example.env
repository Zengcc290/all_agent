# ============================================================
#  知识图谱入库系统 - 环境变量模板
#  复制为 .env 后按实际情况填写：  copy .example.env .env
#  LLM/Embedding 云端配置与主项目一致（迁移自 config/provider.toml
#  与 config/services.toml）；Qdrant / Neo4j 为本机本地服务。
# ============================================================

# ---------- 1. LLM（OpenAI 兼容 /chat/completions，流式输出）----------
# 与主项目 config/provider.toml [profiles.deepseek] 一致（DeepSeek）
LLM_MODEL=deepseek-v4.1-flash
# API 密钥
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 请求地址（base_url，代码会自动拼接 /chat/completions）
LLM_BASE_URL=https://worldclawpro.ai/v1
# 采样温度
LLM_TEMPERATURE=0.1
# 是否流式输出（true / false）
LLM_STREAM=true
# 单次请求超时（秒）
LLM_TIMEOUT=120
# 最大生成 token
LLM_MAX_TOKENS=2048

# ---------- 2. Embedding 模型（与主项目 config/services.toml [embedding] 一致）----------
# 请求地址（base_url，代码会自动拼接 /embeddings）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 模型名称（Qwen3-VL-Embedding-8B 输出 4096 维）
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
# API 密钥
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 向量维度（必须与所选模型一致：Qwen3-VL-Embedding-8B = 4096）
EMBEDDING_DIM=4096
# 单次批量编码条数
EMBEDDING_BATCH_SIZE=32
# 请求超时（秒）
EMBEDDING_TIMEOUT=60

# ---------- 3. Qdrant 向量数据库（本地）----------
# 默认连「本地真实 qdrant 服务」：由 启动所有服务.bat 在 127.0.0.1:6333 拉起
# 本机已安装：C:\Users\liang\qdrant\qdrant.exe
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# 是否走 grpc（false = REST，更省事）
QDRANT_PREFER_GRPC=false
# 集合名称
QDRANT_COLLECTION=kg_chunks
# 若本地未开启鉴权则留空
QDRANT_API_KEY=
# 距离度量：cosine / dot / euclid
QDRANT_DISTANCE=cosine
# 是否在启动时自动创建集合
QDRANT_AUTO_CREATE=true
# 嵌入式本地模式：填一个目录（如 ./data/qdrant）就改用 qdrant 引擎的本地嵌入式存储，
# 不需要单独启动 qdrant 服务；否则连接上面的 QDRANT_HOST:QDRANT_PORT。
# （嵌入式模式同一时刻只允许一个进程打开同一个目录，多进程并发入库时请用上面的服务模式）
QDRANT_LOCAL_PATH=

# ---------- 4. Neo4j 图数据库（本机本地服务）----------
# 本机已安装：C:\Users\liang\neo4j-home\neo4j-community-5.26.12
# 访问链接：bolt://<host>:<port>
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
# 本地 Neo4j 初始密码（与主项目 .env 一致）
NEO4J_PASSWORD=nebula2025
NEO4J_DATABASE=neo4j
# 连接超时（秒）
NEO4J_TIMEOUT=30

# ---------- 5. SQLite（原始文档 / 入库状态 / chunk）----------
SQLITE_PATH=./data/kg.db

# ---------- 6. 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
# 允许跨域的前端地址，多个用逗号分隔，* 表示全部
CORS_ORIGINS=*
# 工具单次并行上限
TOOL_MAX_CONCURRENCY=8
