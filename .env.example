# ===========================================================================
# Web search tool (web.search)
# ===========================================================================
SEARCH_API=
SEARCH_BASE_URL=https://example.invalid/search
SEARCH_TOOL_ENABLED=true

# ===========================================================================
# Chat model: DeepSeek (or any OpenAI-compatible vendor)
# ---------------------------------------------------------------------------
# Copied into config/provider.toml via api_key_env, so the key lives only in
# .env and never in the repo. Without it, /api/chat returns 503 and automatic
# knowledge extraction (LLMKnowledgeExtractor) falls back to a no-op.
# ===========================================================================
DEEPSEEK_API_KEY=

# ===========================================================================
# Memory embedding: OpenAI-compatible /embeddings or Gemini :embedContent
# ---------------------------------------------------------------------------
# Default provider is DashScope (https://dashscope.aliyuncs.com/compatible-mode/v1).
# Point the same variables at any other OpenAI-compatible /embeddings vendor
# (OpenAI, SiliconFlow, Zhipu, local vLLM, ...) to switch providers.
# ===========================================================================
DASHSCOPE_API_KEY=
# HELLOAGENTS_MEMORY_EMBEDDING_API_KEY=        # alternative to DASHSCOPE_API_KEY
# HELLOAGENTS_MEMORY_EMBEDDING_MODEL=qwen3-embedding-0.6b
# HELLOAGENTS_MEMORY_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# HELLOAGENTS_MEMORY_EMBEDDING_DIMENSION=auto  # auto/空 = 首次响应里自动识别维度
# HELLOAGENTS_MEMORY_EMBEDDING_TIMEOUT=30
# HELLOAGENTS_MEMORY_EMBEDDING_BATCH_SIZE=10

# ---------------------------------------------------------------------------
# Google Gemini (protocol differs: x-goog-api-key header, {"content":{"parts":[]}},
# response embedding.values). Supports text, image and mixed image+text input.
# Set provider=gemini explicitly, or leave it on auto and just set the model
# (a "gemini-*" model name or a generativelanguage host is detected).
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# HELLOAGENTS_MEMORY_EMBEDDING_PROVIDER=gemini
# HELLOAGENTS_MEMORY_EMBEDDING_MODEL=gemini-embedding-2
# HELLOAGENTS_MEMORY_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# HELLOAGENTS_MEMORY_EMBEDDING_DIMENSION=768   # 不填用服务端默认 3072；可 1536/768/128

# ---------------------------------------------------------------------------
# Provider override (default auto):
#   auto | gateway (EMBEDDING_BASE_URL tunnel) | gemini | openai | hash
# Any switch changes the vector space -> re-run scripts/reindex_embeddings.py.
# ---------------------------------------------------------------------------
# HELLOAGENTS_MEMORY_EMBEDDING_PROVIDER=auto

# ===========================================================================
# Optional vector-database backend (defaults to an in-process index)
# ===========================================================================
# HELLOAGENTS_MEMORY_QDRANT_URL=http://localhost:6333
# HELLOAGENTS_MEMORY_QDRANT_COLLECTION=helloagents_memory
